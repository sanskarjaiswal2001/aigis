[Unit]
Description=AIgis SRE health check
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/opt/aigis
ExecStart=/opt/aigis/.venv/bin/aigis --auto-fix
EnvironmentFile=/opt/aigis/.env
StandardOutput=journal
StandardError=journal
# Prevent runaway restarts; each run is short-lived (oneshot)
TimeoutStartSec=300
